&DOS
prefix = "top"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/PBE-d3/top/data"  ! directory containing the input data, i.e. the pw.x metadata
bz_sum = "smearing"  ! integration using gaussian smearing
ngauss = 0  ! type of gaussian broadening - 0: Simple Gaussian (default)
degauss = 0.022049593305392995  ! gaussian broadening, Ry (not eV!)
emin = -12.5924
emax = 7.4076
deltaE = 0.01  ! energy grid step (eV)
fildos = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/PBE-d3/top/dos.out"  ! output file containing DOS(E)
/
