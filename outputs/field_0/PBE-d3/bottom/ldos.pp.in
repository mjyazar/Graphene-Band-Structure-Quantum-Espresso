&INPUTPP
prefix = "bottom"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/PBE-d3/bottom/data"  ! directory containing the input data, i.e. the pw.x metadata
plot_num = 3
filplot = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/PBE-d3/bottom/data/ldos.pp.dat"  ! QE intermediate 3D FFT i.e. real-space grid data

emin = -17.5924
emax = 12.4076
delta_e = 0.02
degauss_ldos = 0.2
use_gauss_ldos = .true.
/
&PLOT
filepp(1) = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/PBE-d3/bottom/data/ldos.pp.dat"
iflag = 3
output_format = 5
fileout = ".xsf"
/
