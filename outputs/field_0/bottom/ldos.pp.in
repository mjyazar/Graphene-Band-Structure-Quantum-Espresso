&INPUTPP
                         prefix = "bottom"
                         outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/bottom/data"  ! directory containing the input data, i.e. the pw.x metadata
                         plot_num = 3
                         filplot = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/bottom/data/ldos.pp.dat"  ! intermediate metadata path
                         
                             emin = -14.2193
                             emax = 5.7807
                             delta_e = 0.02
                             degauss_ldos = 0.01
                             /
&PLOT
                         filepp(1) = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/bottom/data/ldos.pp.dat"
                         iflag = 3
                         output_format = 6
                         fileout = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/bottom/ldos.cube"
                         /
