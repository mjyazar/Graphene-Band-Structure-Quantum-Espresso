&INPUTPP
prefix = "bottom"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/ts/bottom/data"  ! directory containing the input data, i.e. the pw.x metadata
plot_num = 0
filplot = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/ts/bottom/data/charge.pp.dat"  ! QE intermediate 3D FFT i.e. real-space grid data

spin_component = 0  ! total charge
/
&PLOT
filepp(1) = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/ts/bottom/data/charge.pp.dat"
iflag = 3
output_format = 6
fileout = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0/ts/bottom/charge.cube"
/
