&CONTROL
   calculation      = 'relax'
   verbosity        = 'high'
   tprnfor          = .true.
   outdir           = '/Users/memo/Desktop/New Horizons/Graphene Band Structure QE/outputs/monolayer/data'
   prefix           = 'graphene'
