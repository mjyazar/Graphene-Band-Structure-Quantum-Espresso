&DOS
prefix = "top"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.005/vdw-df2-c09/top/data"  ! directory containing the input data, i.e. the pw.x metadata
