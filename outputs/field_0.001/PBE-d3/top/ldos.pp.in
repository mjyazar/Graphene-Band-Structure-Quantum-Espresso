&INPUTPP
prefix = "top"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.001/PBE-d3/top/data"  ! directory containing the input data, i.e. the pw.x metadata
plot_num = 3
filplot = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.001/PBE-d3/top/data/ldos.pp.dat"  ! QE intermediate 3D FFT i.e. real-space grid data

emin = -17.4421
emax = 12.5579
delta_e = 0.05
degauss_ldos = 0.2
use_gauss_ldos = .true.
/
&PLOT
filepp(1) = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.001/PBE-d3/top/data/ldos.pp.dat"
iflag = 3
output_format = 5
fileout = ".xsf"
/
