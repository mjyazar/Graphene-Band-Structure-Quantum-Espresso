&DOS
prefix = "bottom"
outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.001/PBE-d3/bottom/data"  ! directory containing the input data, i.e. the pw.x metadata
