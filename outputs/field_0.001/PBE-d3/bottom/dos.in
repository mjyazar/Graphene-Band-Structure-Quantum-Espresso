emin = -17.622700000000002
emax = 12.3773
deltaE = 0.01  ! energy grid step (eV)
fildos = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/field_0.001/PBE-d3/bottom/dos.out"  ! output file containing DOS(E)
/
