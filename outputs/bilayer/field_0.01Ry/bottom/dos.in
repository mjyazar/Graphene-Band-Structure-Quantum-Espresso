                         ngauss = 0  ! type of gaussian broadening - 0: Simple Gaussian (default)
                         degauss = 0.01  ! gaussian broadening, Ry (not eV!)
                         emin = -10
                         emax = 10
                         deltaE = 0.01  ! energy grid step (eV)
                         fildos = '/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/bilayer/field_0.01Ry/bottom/dos.data'  ! output file containing DOS(E)
                         /
                         