&DOS  ! QE input begins
                         prefix = "bottom"
                         outdir = "/home/ubuntu/projects/Graphene-Band-Structure-Quantum-Espresso/outputs/bilayer/field_0.01Ry/bottom/data"  ! directory containing the input data, i.e. the pw.x metadata
